<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<parent>
		<artifactId>IJPay</artifactId>
		<groupId>com.github.javen205</groupId>
		<version>3.0.0</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<packaging>jar</packaging>

	<artifactId>IJPay-Servlet-Jakarta</artifactId>
	<name>${project.artifactId}</name>
	<description>IJPay 让支付触手可及(Easy Pay Library)-jakarta.servlet 适配模块(Servlet 5.0)</description>
	<url>https://github.com/javen205/IJPay</url>

	<properties>
		<automatic.module.name>com.ijpay.servlet.jakarta</automatic.module.name>
		<!-- 3.0.0 新增模块，旧版本 2.9.13 中不存在，显式跳过 japicmp 以免产出虚假的"通过"报告 -->
		<japicmp.skip>true</japicmp.skip>
	</properties>


	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>IJPay-Core</artifactId>
			<version>${project.parent.version}</version>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>IJPay-AliPay</artifactId>
			<version>${project.parent.version}</version>
		</dependency>
		<!-- Jakarta Servlet 5.0 是兼容 Java 8 的最后一条版本线，6.x 的 class 版本为 55 -->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- 仅测试使用：对比 javax 与 jakarta 两套适配实现的一致性 -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>IJPay-Servlet-Javax</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
